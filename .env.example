# Pramaan Backend - Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://yogesh:admin@yoyoyo.gz4qa8u.mongodb.net/?appName=Yoyoyo

# Authentication
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_EXPIRY=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# Blockchain Configuration (Phase 2+)
# ============================================

# Polygon Network (Primary)
POLYGON_RPC_URL=https://rpc.polygonscan.com
POLYGON_TESTNET_RPC_URL=https://rpc-mumbai.maticvigil.com

# Smart Contract
CONTRACT_ADDRESS=0x...your_deployed_contract_address
PRIVATE_KEY=your_wallet_private_key_never_commit_this

# IPFS (for storing product metadata)
IPFS_API_URL=https://api.pinata.cloud
IPFS_JWT_TOKEN=your_pinata_jwt_token

# ============================================
# Payment Gateway Configuration
# ============================================

# Razorpay (for traditional payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Stablecoin Configuration (for crypto payments)
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# ============================================
# Third Party Services
# ============================================

# Email Service (for notifications)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key

# File Upload (for product images)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET_NAME=pramaan-products

# Analytics
SENTRY_DSN=your_sentry_dsn_for_error_tracking
